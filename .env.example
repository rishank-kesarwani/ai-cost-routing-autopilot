# ==============================================================================
# LLM Cost & Routing Autopilot — Unified Environment Configuration Reference
# ==============================================================================
# This file provides an architectural reference for all environment variables.
# In production, deploy frontend variables to Vercel and backend variables to Render.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Runtime Environment (Deploy to Render Web Service)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://ai-cost-routing-autopilot.vercel.app
PUBLIC_ACCESS_ENABLED=true

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-cost-routing-autopilot?retryWrites=true&w=majority

# Redis (BullMQ Queues & High-Throughput Caching)
REDIS_URL=redis://localhost:6379

# Operator JWT Authentication
JWT_ACCESS_SECRET=render_secret_jwt_access_autopilot_2026_prod
JWT_REFRESH_SECRET=render_secret_jwt_refresh_autopilot_2026_prod
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Microservice: Shared AI Platform (Model Gateway)
AI_PLATFORM_URL=https://ai-platform.onrender.com
AI_PLATFORM_API_KEY=platform_master_key_production_secret
AI_PLATFORM_TIMEOUT_MS=10000

# Microservice: Shared Notification Service (Threshold Alerts & Spikes)
NOTIFICATION_SERVICE_URL=https://notification-service.onrender.com
NOTIFICATION_SERVICE_API_KEY=notification_service_api_key_production_secret

# Microservice: Model Regression Detection (Quality Release Gates)
MODEL_REGRESSION_SERVICE_URL=https://ai-model-regression-detection.onrender.com
MODEL_REGRESSION_SERVICE_API_KEY=model_regression_service_api_key_production_secret

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ------------------------------------------------------------------------------
# 2. Frontend Build-Time Environment (Deploy to Vercel Project)
# ------------------------------------------------------------------------------
# Note: Next.js NEXT_PUBLIC_* variables are embedded at build time.
# Updating these requires triggering a new Vercel production build.
NEXT_PUBLIC_API_URL=https://ai-cost-routing-autopilot.onrender.com/api/v1
NEXT_PUBLIC_ACCESS_ENABLED=true
NEXT_PUBLIC_APP_URL=https://ai-cost-routing-autopilot.vercel.app
